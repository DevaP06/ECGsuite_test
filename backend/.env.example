PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secrets — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# Google OAuth 2.0 — https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Shared secret for internal service-to-service calls
INTERNAL_API_KEY=replace_with_a_shared_secret

# ── File uploads (S3 / Cloudflare R2) ──────────────────────────────────────
# Leave blank to use local disk (development only).
# Required in production — Vercel has no persistent filesystem.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
# Optional prefix inside the bucket (default: ecg-uploads)
S3_UPLOAD_PREFIX=ecg-uploads

# ── External ML services (leave blank if not running locally) ───────────────
FLASK_URL=http://127.0.0.1:8001
ONTOLOGY_URL=http://127.0.0.1:8002
